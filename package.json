{
  "name": "ipv6-practice-app",
  "version": "1.0.0",
  "description": "IPv6 Practice Exercises - React App",
  "homepage": "https://axm06051.github.io/IPv6",
  "main": "src/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --coverage --watchAll=false --testResultsProcessor=jest-junit",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "lint:report": "eslint src --ext .js,.jsx,.ts,.tsx --format json --output-file eslint-report.json",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "unused-deps": "npx depcheck --ignores=\"@types/*,eslint-*,prettier-*,@typescript-eslint/*,jest,jest-junit,typescript\"",
    "security-audit": "npm audit --audit-level moderate",
    "quality:check": "npm run format:check && npm run lint && npm run type-check",
    "quality:fix": "npm run format && npm run lint:fix && npm run type-check",
    "quality:full": "npm run quality:fix && npm run test:coverage && npm run unused-deps && npm run security-audit",
    "pre-commit": "npm run quality:check",
    "pre-push": "npm run quality:full",
    "ci": "npm run quality:check && npm run test:ci && npm run build",
    "validate": "npm run quality:check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "ipaddr.js": "^2.3.0",
    "katex": "^0.16.28",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-scripts": "5.0.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx",
      "!src/setupTests.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 9,
        "functions": 9,
        "lines": 11,
        "statements": 11
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "depcheck": "^1.4.7",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3"
  }
}